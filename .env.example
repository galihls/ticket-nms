# Salin file ini menjadi .env lalu sesuaikan nilainya.
# .env TIDAK boleh masuk ke git.

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path URL Django Admin (ganti di produksi demi keamanan pentest)
DJANGO_ADMIN_URL=django-admin/

# ── Single Sign-On (SSO) ──────────────────────────────────────────────────
# Default False di produksi untuk mencegah bypass otentikasi
SSO_ENABLED=False
SSO_DEMO_MODE=False

# ── Database ──────────────────────────────────────────────────────────────
# Dev tanpa setup (default): kosongkan saja, otomatis pakai SQLite.
# Postgres (dipakai docker-compose):
# DATABASE_URL=postgres://ticketing:ticketing@db:5432/ticketing_nms

# ── Zabbix (dipakai mulai Fase 2) ─────────────────────────────────────────
ZABBIX_URL=https://zabbix.example.co.id/api_jsonrpc.php
# Cara yang disarankan: buat API token di Zabbix (Users → API tokens)
ZABBIX_API_TOKEN=
# Alternatif untuk Zabbix 6.0 yang belum punya API token:
ZABBIX_USERNAME=
ZABBIX_PASSWORD=
ZABBIX_VERIFY_SSL=True
ZABBIX_TIMEOUT=30

# ── Email (opsional, produksi) ────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@initech.co.id

# ── Notifikasi & Eskalasi Email 3 Fase ────────────────────────────────────
# URL basis untuk tautan pada email notifikasi (mis. http://localhost:8000 atau http://20.199.199.201)
SITE_BASE_URL=http://localhost:8000
# Fase 1 (1 Hari): Lead NSM
ESCALATION_LEAD_EMAIL=lead.nsm@initech.co.id
# Fase 2 (5 Hari): PM dan Engineer
ESCALATION_PM_EMAIL=pm@initech.co.id
ESCALATION_ENGINEER_EMAIL=engineer@initech.co.id
# Fase 3 (2 Minggu): Direktur
ESCALATION_DIRECTOR_EMAIL=direktur@initech.co.id
